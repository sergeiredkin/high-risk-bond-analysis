__pycache__/
*.pyc
.pytest_cache/

# Local Claude Code permission settings -- contains a live PARSER_API_KEY in
# one of its allow-list entries, must never be committed.
.claude/settings.local.json

# Local environment config -- may contain secrets; .env.example is the
# committed template.
.env

# Generated/accumulated data: sqlite DB, raw MOEX/CBR/e-disclosure caches,
# logs, factlists -- all regenerable via the pipeline, not source.
# (data/* rather than data/ so the !data/exports/ negation below can still
# reach inside the directory -- git prunes negations under a fully-excluded
# parent, so excluding the directory's contents instead is required.)
data/*
!data/exports/
!data/exports/*.csv
